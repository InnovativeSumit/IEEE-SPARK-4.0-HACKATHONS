# ---- JALRAKSHA AI backend configuration ----
# App mode: "demo" runs entirely on generated sample data (no external
# downloads or database required). "production" is a placeholder for
# wiring in the real pipeline described in docs/architecture.md.
APP_MODE=demo

# Used only when APP_MODE=production (not required to run the hackathon demo)
DATABASE_URL=postgresql://jalraksha:jalraksha@localhost:5432/jalraksha
SATELLITE_DATA_PATH=./data/raw/sentinel
DEM_DATA_PATH=./data/raw/dem
POPULATION_DATA_PATH=./data/raw/population
OSM_DATA_PATH=./data/raw/osm
MODEL_PATH=./ml/models

# Frontend origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Optional: only needed if you want the AI Analyst to use a real LLM to
# phrase its answers. Without it, the AI Analyst still works — it falls
# back to a deterministic template that is generated from the same
# retrieved backend numbers, so answers are never fabricated either way.
ANTHROPIC_API_KEY=
